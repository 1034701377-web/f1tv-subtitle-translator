# 推荐在本机首页保存配置；手动配置时可复制为 .env。
# .env 不可提交或分享。开发演示无需 API 密钥。
TRANSLATION_MODE=api

# api 模式使用任意兼容 chat/completions 的服务。
# 填写完整 URL，通常以 /chat/completions 结尾。
API_ENDPOINT=https://api.deepseek.com/chat/completions
API_MODEL=deepseek-flash
# 留空不发送 thinking 参数；支持此参数的服务可设 disabled 或 enabled。
# DeepSeek 关闭思考：API_THINKING=disabled
API_THINKING=disabled
API_KEY=
API_TIMEOUT_MS=8000

# 可选 TR：下面三项留空时只启用官方字幕翻译。
# ASR_ENDPOINT 示例：wss://你的工作空间.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# ASR_MODEL 示例：qwen-audio-3.1-asr-flash-streaming
ASR_ENABLED=false
ASR_ENDPOINT=
ASR_MODEL=
DASHSCOPE_API_KEY=
ASR_TIMEOUT_MS=25000
