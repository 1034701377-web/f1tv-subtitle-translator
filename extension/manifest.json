{
  "manifest_version": 3,
  "name": "F1 TV 中文字幕 · 解说与车队无线电",
  "version": "0.10.1",
  "minimum_chrome_version": "116",
  "description": "翻译 F1 TV 官方字幕与 Track FX 车队无线电，按节目时间显示。自备模型 API，无需油猴或本机服务。非官方项目。",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://f1tv.formula1.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "wss://*/*"],
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "F1 TV 中文字幕与声音采集",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://f1tv.formula1.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://f1tv.formula1.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https: wss:"
  }
}
